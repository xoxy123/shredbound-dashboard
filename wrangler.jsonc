{
  "name": "shredbound-dashboard",
  "main": "src/server.js",
  "compatibility_date": "2026-09-01",
  "rules": [{"type":"Text","globs":["**/*.html","**/*.css","**/*.txt"],"fallthrough":true}],
  "d1_databases": [{"binding":"DB","database_name":"shredbound-dashboard","database_id":"local","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"UPLOADS","bucket_name":"shredbound-dashboard-media"}]
}
